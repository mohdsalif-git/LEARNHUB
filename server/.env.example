PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/learnhub?retryWrites=true&w=majority

# JWT Secret: MUST be at least 32 cryptographically random bytes in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_at_least_32_bytes

CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
