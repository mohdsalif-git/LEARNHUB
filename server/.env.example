PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/learnhub?retryWrites=true&w=majority

# JWT Secret: MUST be at least 32 cryptographically random bytes in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_at_least_32_bytes

CLIENT_URL=http://localhost:5173

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Automation Pipeline (NEW) ──────────────────────────────────────────────────
# YouTube Data API v3 key — get from https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# GitHub Personal Access Token (fine-grained, read:public_repo scope is sufficient)
# Leave blank to use unauthenticated rate limits (60 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here
# ──────────────────────────────────────────────────────────────────────────────
